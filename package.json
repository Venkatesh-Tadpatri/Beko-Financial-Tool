{
  "name": "financial-visualization-tool",
  "productName": "Financial Visualization Tool",
  "version": "1.0.0",
  "description": "Financial Visualization Tool for SAP sales and financial reporting",
  "private": true,
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:renderer": "vite build --config renderer/vite.config.mts",
    "build:desktop": "tsc -p desktop/tsconfig.json",
    "build": "npm run build:renderer && npm run build:desktop",
    "typecheck": "tsc -p renderer/tsconfig.json --noEmit && tsc -p desktop/tsconfig.json --noEmit",
    "test": "vitest run --config renderer/vite.config.mts",
    "test:watch": "vitest --config renderer/vite.config.mts",
    "test:backend": "backend\\.venv\\Scripts\\python.exe -m pytest -q backend/tests"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
